# Agora Console > Project > Manage credentials
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora account > RESTful API credentials
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Numeric UID reserved for the remote voice agent
AGORA_AGENT_UID=1002
AGORA_ASR_LANGUAGE=en-IN

# OpenAI key powers Vibe's conversational reasoning (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Murf key powers the agent's spoken voice via Murf Falcon (server-side only)
MURF_API_KEY=
MURF_VOICE_ID=Matthew
MURF_LOCALE=en-US

PORT=3001
