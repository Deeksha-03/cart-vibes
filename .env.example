# Optional Agora Conversational AI integration.
# Never commit real credentials. Copy this file to .env and fill values locally.
AGORA_APP_ID=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_CHANNEL=
AGORA_AGENT_TOKEN=
AGORA_AGENT_UID=1002
AGORA_REMOTE_UID=1001

# Optional: published Agora Conversational AI Studio agent pipeline ID.
AGORA_PIPELINE_ID=

# Optional Murf key (keep server-side only).
MURF_API_KEY=

# Optional OpenAI-compatible LLM (not required for the demo flow).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
