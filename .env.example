# Agora Console > Project > Manage credentials
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora agent configuration. The managed LLM below does not need an OpenAI API key.
AGORA_AGENT_UID=1002
AGORA_ASR_LANGUAGE=en-IN
AGORA_LLM_MODEL=gpt-4o-mini

# Murf API key is required: Murf Falcon uses BYOK with Agora.
MURF_API_KEY=
MURF_VOICE_ID=Matthew
MURF_LOCALE=en-US

# Optional: used only by the separate website text-chat endpoint, not Agora voice.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=3001
