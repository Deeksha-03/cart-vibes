# Agora Console > Project > Manage credentials
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_AGENT_UID=1002

# Agora-managed real-time speech recognition and LLM
AGORA_ASR_MODEL=nova-3
AGORA_LLM_MODEL=gpt-4o-mini

# Murf Falcon 2.1 voice settings
# Neeta supports both en-IN and kn-IN with Conversational style.
MURF_API_KEY=
MURF_VOICE_ID=Neeta
MURF_MODEL=falcon-2.1
MURF_STYLE=Conversational
MURF_BASE_URL=wss://global.api.murf.ai/v1/speech/stream-input
MURF_RATE=0
MURF_PITCH=0
MURF_SAMPLE_RATE=24000

# Required only for the voice agent to call CartVibes shopping APIs.
# Set this to a public HTTPS tunnel URL for your local server (not localhost).
AGORA_PUBLIC_BASE_URL=
# Generate with: openssl rand -hex 32
AGORA_TOOL_SHARED_SECRET=

# Optional key for the separate website text-chat fallback only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=3001
